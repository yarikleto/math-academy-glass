{
  "manifest_version": 3,
  "name": "Math Academy Glass",
  "version": "2.0.28",
  "homepage_url": "https://yarikleto.github.io/math-academy-glass/",
  "minimum_chrome_version": "111",
  "description": "An unofficial glass theme and local study toolkit for Math Academy, with light, dark, and system modes.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/storage-controller.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "Math Academy Glass",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mathacademy.com/*"],
      "css": [
        "styles/00-foundation.css",
        "styles/10-task-flow.css",
        "styles/11-navigation-and-menus.css",
        "styles/20-marketing.css",
        "styles/21-login.css",
        "styles/22-public-pages.css",
        "styles/23-public-forms.css",
        "styles/30-shared-components.css",
        "styles/40-topics.css",
        "styles/45-help.css",
        "styles/50-settings.css",
        "styles/60-course-progress.css",
        "styles/60-learn-dashboard.css",
        "styles/61-learn-lessons.css",
        "styles/62-learn-math-tools.css",
        "styles/63-learn-content.css",
        "styles/64-learn-overlays.css",
        "styles/65-reading.css",
        "styles/66-card-export.css",
        "styles/70-study-instruments.css",
        "styles/71-study-tools-ui.css"
      ],
      "js": [
        "content/theme/context.js",
        "content/theme/extension-state.js",
        "content/theme/appearance.js",
        "content/theme/math-editor.js",
        "content/theme/daily-goal.js",
        "content/theme/task-timer.js",
        "content/theme/task-completion.js",
        "content/theme/course-progress.js",
        "content/theme/card-export.js",
        "content/theme/dashboard.js",
        "content/theme-controller.js",
        "content/tools/runtime.js",
        "content/tools/drawing.js",
        "content/tools/ruler.js",
        "content/tools/protractor-face.js",
        "content/tools/protractor.js",
        "content/tools/compass.js",
        "content/tools/interface.js",
        "content/tools-controller.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg",
        "icons/exit.svg",
        "icons/progress-chevron.svg",
        "icons/math-*.svg",
        "icons/completed-checkmark.svg",
        "icons/unlocked.svg",
        "icons/promotion-arrow.svg",
        "icons/demotion-arrow.svg",
        "icons/leagues/*.svg"
      ],
      "matches": ["https://*.mathacademy.com/*"]
    }
  ]
}
